# =============================================================================
# Nexus Credit Passport — Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in your values.
# .env.local is gitignored. NEVER commit real secrets.
#
# For Docker: docker-compose reads .env.local via `env_file: .env.local`
# For local dev (outside Docker): each service loads ../../.env.local
# =============================================================================

# ── Database ──────────────────────────────────────────────────────────────────
# Used by FastAPI (asyncpg driver) and Alembic migrations
DATABASE_URL=postgresql+asyncpg://nexus:nexus@localhost:5432/nexus
# Used by Go ingestion (pgx v5 driver, plain postgres:// scheme)
DATABASE_URL_GO=postgres://nexus:nexus@localhost:5432/nexus

# ── API Service ───────────────────────────────────────────────────────────────
API_KEY=dev-secret-change-me-in-prod
SECRET_KEY=dev-jwt-secret-change-me-in-prod
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
ENVIRONMENT=development

# Scoring service URL (called by FastAPI to proxy score requests)
SCORING_SERVICE_URL=http://localhost:8081
# Ingestion service URL (called by FastAPI to proxy ingest requests)
INGESTION_SERVICE_URL=http://localhost:8080

# ── Setu Account Aggregator ────────────────────────────────────────────────────
# For development: point to local mock server
# For sandbox: https://fiu-sandbox.setu.co (swap via config only — no code change)
SETU_BASE_URL=http://localhost:9090
SETU_CLIENT_ID=dev-client-id
SETU_CLIENT_SECRET=dev-client-secret
SETU_PRODUCT_INSTANCE_ID=dev-product-instance-id
# Your FIU entity ID as registered on bridge.setu.co
SETU_FIU_ENTITY_ID=dev-fiu-entity-id

# ── GSTN ──────────────────────────────────────────────────────────────────────
GSTN_BASE_URL=http://localhost:9091
BUSINESS_GSTIN=29ABCDE1234F2Z5

# ── Razorpay ──────────────────────────────────────────────────────────────────
RAZORPAY_BASE_URL=http://localhost:9092
RAZORPAY_KEY_ID=rzp_test_xxxxx
RAZORPAY_KEY_SECRET=dev-razorpay-secret

# ── Zoho Books ────────────────────────────────────────────────────────────────
ZOHO_BASE_URL=http://localhost:9093
ZOHO_CLIENT_ID=dev-zoho-client-id
ZOHO_CLIENT_SECRET=dev-zoho-client-secret
ZOHO_ORG_ID=dev-zoho-org-id

# ── Crypto: age Asymmetric Encryption (PII Fields) ───────────────────────────
# Ingestion (Go) encrypts with the public key.
# Scoring (Rust) decrypts with the private key — NEVER share the private key.
#
# DEV KEYPAIR — generated 2026-07-13 for local development only.
# Rotate before any staging/production deployment.
# Public key (safe to share, ingestion service uses this):
AGE_PUBLIC_KEY=age1xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Private key (SCORING SERVICE ONLY — keep secret):
AGE_PRIVATE_KEY=AGE-SECRET-KEY-1XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ── Crypto: HMAC Blind Index (Transaction Dedup) ──────────────────────────────
# 32-byte hex key for HMAC-SHA256(key, external_txn_id) → external_id_hmac column.
# This index enables dedup queries without storing raw FIP transaction IDs.
# Separate key from the age encryption keypair.
HMAC_BLIND_INDEX_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Next.js Web ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
# Demo business ID — hardcoded for Phase 2 (no auth yet)
NEXT_PUBLIC_BUSINESS_ID=00000000-0000-0000-0000-000000000001
